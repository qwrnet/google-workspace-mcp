{
  "name": "google-workspace-mcp",
  "version": "0.2.1",
  "description": "MCP server for Google Workspace APIs",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "google-workspace-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "node --import ./test/register.mjs --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
